# CampusConnect Security Lab — Environment Variables Example
# Copy this file to .env and adjust values for your local setup.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=campusconnect_lab
DB_USER=root
DB_PASS=

# ── Application ───────────────────────────────────────────────────────────────
SITE_URL=http://localhost/campusconnect-security-lab

# ── Lab Mode ─────────────────────────────────────────────────────────────────
# Set in config/config.php:
#   LAB_MODE = true   → weak authentication (vulnerable)
#   LAB_MODE = false  → hardened configuration (rate limiting + lockout)
